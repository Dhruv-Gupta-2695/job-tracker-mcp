# Caddy gets and renews free https certificates by itself.
# To host another project on this server, copy a block like this one,
# add a service for it in docker-compose.yml and point its name at it.
{$NEXTSTEP_DOMAIN} {
	encode gzip
	reverse_proxy nextstep:8000
}

# Market Analyst (Streamlit UI). Websockets work through reverse_proxy by default.
{$MARKET_DOMAIN} {
	encode gzip
	reverse_proxy marketanalyst:8501
}
