# Copy this file to deploy/.env on the server and fill it in. Never commit .env.

# Public address Caddy serves (your DuckDNS name), no https://
NEXTSTEP_DOMAIN=yourname.duckdns.org

# Firebase project the sign-in belongs to
FIREBASE_PROJECT_ID=job-tracker-820d3
# Optional: only if you changed the Firebase auth host
# FIREBASE_AUTH_HOST=job-tracker-820d3.firebaseapp.com

# Email sending (keep sending off until you are ready)
ENABLE_EMAIL_SEND=false
REPLY_SECRET=
MAX_SENDS_PER_DAY=5

# Copy any other variables your Render service uses (job-tracker-multi) here.
