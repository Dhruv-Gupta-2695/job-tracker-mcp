# Copy this file to .env and fill in your own values. Never commit the real .env.

# --- Gmail (from Google Cloud Console, see README) ---
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# --- Telegram (from @BotFather + get_telegram_chat_id.py) ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# --- Tracker (Google Sheet -- run create_google_sheet.py once to get this) ---
GOOGLE_SHEET_ID=

# --- Polling ---
POLL_INTERVAL_MINUTES=15
INITIAL_LOOKBACK_DAYS=30

# --- Stale-application follow-up nudges (0 disables) ---
STALE_NUDGE_DAYS=21
